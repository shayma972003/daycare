generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Period {
  MORNING
  EVENING
}

enum Gender {
  MALE
  FEMALE
}

/// Payment state of a student's subscription.
///
/// This was a free-text String that received English values from the status
/// updater and the Arabic literal "بانتظار الدفع" from the enrolment flow — one
/// logical state machine written in two alphabets. The finance layer only knew
/// three of the values, so SUSPENDED students (who owe the most) were silently
/// dropped from every collection total. Arabic labels now live in the UI.
enum PaymentStatus {
  PENDING
  PAID
  LATE
  SUSPENDED
  CANCELLED
}

/// How a child attends. Was a free-text String defaulting to "دوام منتظم".
/// SHIFTS exists because live rows already held "شفتات" — folding it into
/// PART_TIME would have quietly changed what those records mean.
enum AttendanceType {
  REGULAR
  PART_TIME
  SHIFTS
  TEMPORARY
}

/// Age band of the child. Was a free-text String.
enum AcademicStage {
  NURSERY
  KG1
  KG2
  KG3
}

/// Class grouping. Was a free-text String defaulting to "kg1".
enum ClassGroup {
  NURSERY
  KG1
  KG2
  KG3
}

/// State of a single billing cycle. Was free-text Arabic
/// ("بانتظار الدفع" | "مدفوع" | "متأخر" | "موقف").
enum PaymentCycleStatus {
  PENDING
  PAID
  OVERDUE
  SUSPENDED
  CANCELLED
}

/// State of a platform invoice issued to a school. Was free-text Arabic
/// defaulting to "متأخر".
enum AdminInvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum NotificationType {
  WHATSAPP
  EMAIL
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum InvoiceType {
  STUDENT
  TEACHER
}

/// Records every bulk export of tenant data.
///
/// Exports are the widest data-egress path in the product: one click can pull a
/// full roster of children into a spreadsheet that then lives outside every
/// control this system has. Nothing recorded who did that, over what filter, or
/// how many records left. This table is the answer to "what was taken, by whom,
/// when" — required to investigate a leak, and expected under PDPL.
///
/// Deliberately append-only: no API updates or deletes it.
model ExportAuditLog {
  id String @id @default(cuid())

  /// Operational — tenant scope.
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  /// PII — the acting user, retained for accountability.
  userId   String?
  userName String?

  /// Operational — what was exported and how it was narrowed.
  exportedEntity String
  exportFormat   String @default("excel")
  filters        Json?
  recordCount    Int    @default(0)

  /// PII — request provenance.
  ipAddress String?
  userAgent String?

  exportedAt DateTime @default(now())

  @@index([schoolId, exportedAt])
  @@index([exportedEntity])
}

/// Fixed-window counter used for rate limiting and account lockout. Backed by
/// the database because the deployment is serverless — there is no shared
/// in-process memory between invocations.
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model SuperAdmin {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
}

model SubscriptionPlan {
  id                     String   @id @default(cuid())
  name                   String   @unique
  price                  Float
  max_students           Int
  max_classes            Int
  max_whatsapp_per_month Int
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  schools School[]
}

model AdminMessage {
  id           String    @id @default(cuid())
  subject      String
  body         String
  channel      String    @default("both")
  target_type  String
  scheduled_at DateTime?
  sent_at      DateTime?
  is_automated Boolean   @default(false)
  template_key String?
  created_at   DateTime  @default(now())

  recipients AdminMessageRecipient[]
}

model AdminMessageRecipient {
  id           String    @id @default(cuid())
  message_id   String
  school_id    String
  delivered_at DateTime?
  read_at      DateTime?

  message AdminMessage @relation(fields: [message_id], references: [id])
  school  School       @relation(fields: [school_id], references: [id])
}

model AutomatedAlertRule {
  id               String   @id @default(cuid())
  trigger_type     String
  threshold_days   Int?
  message_subject  String
  message_template String
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model AdminActivityLog {
  id           String   @id @default(cuid())
  school_id    String?
  action       String
  metadata     Json?
  performed_by String   @default("system")
  performed_at DateTime @default(now())

  school School? @relation(fields: [school_id], references: [id])
}

model School {
  id String @id @default(cuid())

  /// Analytics — pseudonymous handle. The analytics layer may join on this and
  /// never on `id`, so a reporting query cannot reach back into operational
  /// rows. NOTE: because it lives beside the real id in the same database this
  /// is pseudonymisation, not anonymisation — the data is still personal data.
  analyticsId String @unique @default(uuid())

  /// Operational
  name      String
  /// PII — contact address for the account.
  email     String?
  logoUrl   String?
  plan      String   @default("basic")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // School hours for attendance calculations (HH:mm format)
  teacherCheckinTime  String?
  teacherCheckoutTime String?
  studentCheckinTime  String?
  studentCheckoutTime String?

  // Legal information
  commercialRegistration String?
  vatNumber              String?
  contactNumber          String?
  address                String?
  phoneNumber            String?
  twoFaEnabled           Boolean  @default(false)
  twoFaPhone             String?

  // Opaque, rotatable credential for the walk-up attendance kiosk. The school id
  // used to serve that role, which made a printed QR an unrevocable permanent key
  // to the full child roster.
  attendanceToken          String?   @unique
  attendanceTokenCreatedAt DateTime?

  // Business identity (registration wizard — Step 1)
  legalName              String?
  nationalUnifiedNumber  String?
  entityType             String?
  businessActivities     String?

  // School information (registration wizard — Step 2)
  schoolType             String?
  educationStages        String[] @default([])
  licenseNumber          String?
  branch                 String?

  // Tax & Zakat (registration wizard — Step 3)
  vatRegistered          Boolean?
  zatcaUnifiedNumber     String?
  zakatStatus            String?  // "yes" | "no" | "needs_review"
  financialYear          String?
  taxPeriod              String?

  // Admin panel fields
  plan_id             String?
  subscription_status String    @default("active")
  renewal_date        DateTime?
  suspended_at        DateTime?
  suspension_reason   String?
  last_login_at       DateTime?

  subscription_plan SubscriptionPlan?       @relation(fields: [plan_id], references: [id])
  admin_messages    AdminMessageRecipient[]
  activity_logs     AdminActivityLog[]

  users            User[]
  teachers         Teacher[]
  classes          Class[]
  students         Student[]
  guardians        Guardian[]
  activities       Activity[]
  invoices         Invoice[]
  notificationLogs NotificationLog[]
  settings         Settings?
  monthlyExpenses  MonthlyExpense[]
  import_sessions   ImportSession[]
  financial_reports FinancialReport[]
  expenses          Expense[]
  enrollment_tokens       EnrollmentToken[]
  enrollment_submissions  EnrollmentSubmission[]
  twoFaSessions           TwoFASession[]
  admin_invoices          AdminInvoice[]
  activity_log_entries    ActivityLog[]
  payment_cycles          PaymentCycle[]
  export_logs             ExportAuditLog[]
}

model PaymentCycle {
  id           String    @id @default(cuid())
  school_id    String
  student_id   String
  due_date     DateTime
  amount       Float
  status       PaymentCycleStatus @default(PENDING)
  cycle_number Int // 1 = first payment, 2 = second, etc.
  notified_at  DateTime?
  created_at   DateTime  @default(now())

  school  School  @relation(fields: [school_id], references: [id])
  student Student @relation(fields: [student_id], references: [id])

  @@index([school_id, due_date])
  @@index([student_id])
}

model ActivityLog {
  id           String   @id @default(cuid())
  school_id    String
  action       String   // نص وصفي للإجراء
  entity_type  String?  // "student" | "teacher" | "class" | "settings" | "invoice" | "auth" | etc
  entity_id    String?  // id العنصر المتأثر
  entity_name  String?  // اسم العنصر للعرض
  performed_by String   // اسم المستخدم أو "النظام"
  ip_address   String?
  device_info  String?  // User-Agent parsed: "Chrome على Windows"
  created_at   DateTime @default(now())

  school School @relation(fields: [school_id], references: [id])

  @@index([school_id, created_at])
}

model AdminInvoice {
  id                 String    @id @default(cuid())
  school_id          String
  invoice_number     String
  subscription_type  String?
  issue_date         DateTime  @default(now())
  due_date           DateTime?
  status             AdminInvoiceStatus @default(PENDING)
  payment_method     String?

  // معلومات شركتنا (SaaS provider) — قابلة للتعديل
  our_company_name   String?
  our_commercial_reg String?
  our_vat_number     String?
  our_contact_number String?
  our_email          String?
  our_address        String?

  // معلومات المدرسة — مسحوبة من DB وقابلة للتعديل
  school_name           String
  school_commercial_reg String?
  school_vat_number     String?
  school_contact        String?
  school_email          String?
  school_address        String?

  line_items   Json // array of line item objects
  total_amount Float @default(0)
  file_url     String?
  created_at   DateTime @default(now())

  school School @relation(fields: [school_id], references: [id])
}

model TwoFASession {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  userId             String?  // set for purpose=LOGIN, identifies which User is completing login
  purpose            String   @default("LOGIN") // "LOGIN" | "ACTIVATE"
  otpCodeHash        String   // bcrypt hash of the 6-digit OTP, never store plaintext
  attempts           Int      @default(0)
  verified           Boolean  @default(false)
  expiresAt          DateTime
  bypassTokenHash    String?  // sha256 hex of a random bypass token, set only after successful verify (LOGIN purpose)
  bypassExpires      DateTime?
  createdAt          DateTime @default(now())

  // Resend rotates the code on this same row rather than creating a new session,
  // so `attempts` is never reset and the lockout cannot be bypassed.
  lastSentAt  DateTime @default(now())
  resendCount Int      @default(0)

  @@index([bypassTokenHash])
  @@index([expiresAt])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // sha256 of the OTP — never store the code itself. Lookup is by userId, so a
  // bare 6-digit code is useless without knowing whose account it belongs to.
  tokenHash String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Settings {
  id                String   @id @default(cuid())
  schoolId          String   @unique
  school            School   @relation(fields: [schoolId], references: [id])
  hourlyLateFee     Float    @default(0)
  dailyStudentFee   Float    @default(0)
  monthlyStudentFee Float    @default(0)
  reminderTemplate  String   @default("مرحباً، <guardian_name>، نود إعلامكم بأن الرسوم المستحقة على <child_name> بمبلغ <amount_due> ريال تستحق بتاريخ <due_date>. مع تحيات <school_name>")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Class {
  id               String   @id @default(cuid())
  name             String
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id])
  teacherId        String?
  teacher          Teacher? @relation(fields: [teacherId], references: [id])
  group            ClassGroup @default(KG1)
  period           Period   @default(MORNING)
  registrationDate DateTime @default(now())
  notes            String?
  imageUrl         String?
  deletedAt           DateTime?
  needsTeacherWarning Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  students        Student[]
  activityInvites ActivityInvite[]
  attendances     Attendance[]

  @@index([schoolId, deletedAt])
  @@index([teacherId])
}

model Teacher {
  id String @id @default(cuid())

  /// Analytics — pseudonymous handle; see the note on School.analyticsId.
  analyticsId String @unique @default(uuid())

  /// PII
  name     String
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  period   Period @default(MORNING)

  /// Sensitive — national ID, retained only in encrypted form.
  /// `idNumber` is the legacy plaintext column, kept nullable during the
  /// transition and cleared once every row is migrated.
  idNumber          String?
  encryptedIdNumber String?
  /// HMAC-SHA256 with a server-side pepper — NOT a plain hash. A Saudi national
  /// ID is 10 digits with known structure (<10^9 values), so a bare SHA-256 is
  /// reversible by exhaustive search in minutes and would not be anonymous.
  idNumberHash      String?

  /// PII
  dateOfBirth DateTime?
  nationality String?
  email       String?
  phone1      String?
  phone2      String?
  paymentMethod     PaymentMethod @default(CASH)
  joinDate          DateTime      @default(now())
  enrollmentEndDate DateTime?
  monthlySalary     Float         @default(0)
  lateDeductionRate Float         @default(0)
  qualification1    String?
  qualification2    String?
  qualification3    String?
  qualification4    String?
  qualification5    String?
  qualification6    String?
  qualification7    String?
  qualification8    String?
  qualification9    String?
  qualification10   String?
  attendanceHours   Float         @default(0)
  lateHours         Float         @default(0)
  isActive          Boolean       @default(true)
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  classes            Class[]
  activities         Activity[]
  teacherAttendances TeacherAttendance[]
  invoices           Invoice[]

  @@index([schoolId, idNumberHash])
  @@index([schoolId, deletedAt])
}

model Guardian {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id])
  name      String
  phone1    String?
  phone2    String?
  email     String?
  name_2    String?
  phone_3   String?
  phone_4   String?
  email_2   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  students Student[]

  @@index([schoolId, deletedAt])
  @@index([schoolId, phone1])
}

model Student {
  id String @id @default(cuid())

  /// Analytics — pseudonymous handle; see the note on School.analyticsId.
  analyticsId String @unique @default(uuid())

  /// PII
  name       String
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  classId    String?
  class      Class?    @relation(fields: [classId], references: [id])
  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id])

  /// Sensitive — health notes about a child.
  healthCondition String?
  /// Sensitive
  allergies       String?

  /// Operational
  academicStage AcademicStage?
  period        Period         @default(MORNING)

  /// Sensitive — national ID. See Teacher.idNumberHash for why this is an HMAC.
  idNumber          String?
  encryptedIdNumber String?
  idNumberHash      String?

  /// PII
  dateOfBirth      DateTime?
  nationality      String?
  gender           Gender    @default(MALE)
  registrationDate DateTime  @default(now())

  /// Operational
  paymentMethod     PaymentMethod  @default(CASH)
  enrollmentEndDate DateTime?
  paymentStatus     PaymentStatus  @default(PENDING)
  attendanceHours   Float          @default(0)
  lateHours         Float          @default(0)
  attendanceType    AttendanceType @default(REGULAR)
  registration_fee  Float          @default(0)
  additionalFile    String?
  evaluationFileUrl  String?
  evaluationFileName String?
  avatarUrl         String?
  isActive          Boolean       @default(true)
  deletedAt         DateTime?
  needsClassWarning Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  enrollment_date        DateTime?
  payment_notified_at    DateTime? // last time expiry popup was shown
  suspension_notified_at DateTime? // last time suspension popup was shown
  auto_status_updated_at DateTime? // last automatic status update

  /// Operational — data lifecycle. `retentionUntil` is when the personal fields
  /// must be destroyed; `anonymizedAt` records when that happened. The
  /// anonymisation service itself is deferred (see D3 in the plan) — the columns
  /// exist now so the decision is not lost and no backfill is needed later.
  retentionUntil DateTime?
  anonymizedAt   DateTime?

  attendances     Attendance[]
  invoices        Invoice[]
  payment_cycles  PaymentCycle[]

  @@index([schoolId, idNumberHash])
  @@index([schoolId, deletedAt])
  @@index([schoolId, isActive])
  @@index([classId])
  @@index([guardianId])
  @@index([retentionUntil])
}

model Activity {
  id            String   @id @default(cuid())
  name          String
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  teacherId     String?
  teacher       Teacher? @relation(fields: [teacherId], references: [id])
  group         ClassGroup @default(KG1)
  period        Period   @default(MORNING)
  childrenCount Int      @default(0)
  startDate     DateTime
  endDate       DateTime
  activityFee   Float    @default(0)
  imageUrl      String?
  message       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activityInvites ActivityInvite[]

  @@index([schoolId])
}

model ActivityInvite {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([activityId, classId])
}

model Attendance {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id])
  schoolId    String
  checkinAt   DateTime?
  checkoutAt  DateTime?
  lateMinutes Int       @default(0)
  lateFee     Float     @default(0)
  date        DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // One row per child per day. Every check-in path did findFirst-then-create,
  // so a double tap or a retried request silently produced two rows for the
  // same day and the board showed whichever came back first.
  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([classId, date])
}

model TeacherAttendance {
  id            String    @id @default(cuid())
  teacherId     String
  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  schoolId      String
  checkinAt     DateTime?
  checkoutAt    DateTime?
  lateMinutes   Int       @default(0)
  requiredHours Float?
  compensated   Boolean   @default(false)
  date          DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([teacherId, date])
  @@index([schoolId, date])
}

model Invoice {
  id        String      @id @default(cuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id])
  type      InvoiceType
  studentId String?
  student   Student?    @relation(fields: [studentId], references: [id])
  teacherId String?
  teacher   Teacher?    @relation(fields: [teacherId], references: [id])
  amount    Float
  vat_amount Float      @default(0)
  pdfUrl    String?
  data      Json
  createdAt DateTime    @default(now())

  @@index([schoolId, createdAt])
  @@index([studentId])
  @@index([teacherId])
}

model NotificationLog {
  id            String           @id @default(cuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id])
  recipientName String
  type          NotificationType
  content       String
  status        DeliveryStatus   @default(SENT)
  source        String           @default("other")
  sentAt        DateTime         @default(now())

  @@index([schoolId, sentAt])
}

model MonthlyExpense {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  month       Int
  year        Int
  rent        Float    @default(0)
  maintenance Float    @default(0)
  materials   Float    @default(0)
  misc        Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, month, year])
}

model Expense {
  id           String    @id @default(cuid())
  school_id    String
  title        String
  description  String?
  amount       Float
  type         String    // "one_time" | "monthly"
  start_date   DateTime
  end_date     DateTime? // تاريخ انتهاء الاشتراك الشهري (اختياري)
  is_active    Boolean   @default(true)
  stopped_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  school School @relation(fields: [school_id], references: [id])

  @@index([school_id, is_active])
}

model FinancialReport {
  id           String   @id @default(cuid())
  school_id    String
  name         String
  type         String
  period_label String
  file_url     String
  issued_at    DateTime @default(now())

  school School @relation(fields: [school_id], references: [id])
}

model ImportSession {
  id                         String    @id @default(cuid())
  school_id                  String
  type                       String
  status                     String    @default("pending")
  total_rows                 Int       @default(0)
  valid_rows                 Int       @default(0)
  error_rows                 Int       @default(0)
  duplicate_guardians_reused Int       @default(0)
  column_mapping             Json?
  original_headers           Json?
  file_language              String?
  created_at                 DateTime  @default(now())
  expires_at                 DateTime
  completed_at               DateTime?

  school School      @relation(fields: [school_id], references: [id])
  rows   ImportRow[]
}

model ImportRow {
  id          String   @id @default(cuid())
  session_id  String
  row_number  Int
  raw_data    Json
  mapped_data Json?
  status      String   @default("pending")
  errors      Json?
  warnings    Json?
  created_at  DateTime @default(now())

  session ImportSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model EnrollmentToken {
  id        String @id @default(cuid())
  school_id String

  // Generated with crypto.randomBytes, not cuid(): a cuid embeds a timestamp and
  // a monotonic counter, so tokens issued around the same time are guessable
  // from one another — and this token is the only thing standing in front of a
  // child's enrolment form.
  token String @unique

  sent_to_phone String
  sent_to_email String?
  status        String @default("pending") // "pending" | "active" | "completed" | "expired"

  // sha256 of the OTP. It used to be stored in plaintext and compared with !==,
  // with no attempt counter, against a token that stayed valid for 24 hours.
  otp_code_hash    String?
  otp_attempts     Int       @default(0)
  otp_resend_count Int       @default(0)
  otp_last_sent_at DateTime?
  otp_verified     Boolean   @default(false)
  otp_expires_at   DateTime?

  device_fingerprint String?
  submissions_count  Int      @default(0)
  max_submissions    Int      @default(4)
  created_at         DateTime @default(now())
  expires_at         DateTime

  school      School                 @relation(fields: [school_id], references: [id])
  submissions EnrollmentSubmission[]

  @@index([school_id, status])
  @@index([expires_at])
}

model EnrollmentSubmission {
  id              String    @id @default(cuid())
  token_id        String
  school_id       String
  status          String    @default("pending_review") // "pending_review" | "approved" | "rejected"

  full_name        String
  id_number        String?
  nationality      String?
  academic_stage   String?
  gender           String?
  period           String?
  date_of_birth    DateTime?
  health_condition String?
  allergies        String?
  attendance_type  String?
  payment_method   String?

  guardian_name    String?
  guardian_phone_1 String?
  guardian_phone_2 String?
  guardian_email   String?
  guardian_name_2  String?
  guardian_phone_3 String?
  guardian_phone_4 String?
  guardian_email_2 String?

  enrollment_date       DateTime?
  evaluation_file_url   String?
  evaluation_file_name  String?

  submitted_at DateTime  @default(now())
  reviewed_at  DateTime?
  student_id   String?

  token  EnrollmentToken @relation(fields: [token_id], references: [id])
  school School          @relation(fields: [school_id], references: [id])

  @@index([school_id, status])
}

.env
.env.*
!.env.example

# ─── Uploads / User Content ──────────────────────────────────────────────────
public/uploads/

# ─── Generated Fonts (copied during build) ───────────────────────────────────
public/fonts/

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Debug Logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.vscode/
!.vscode/extensions.json
.idea/

# ─── Vercel / Deployment ─────────────────────────────────────────────────────
.vercel

# ─── Misc ────────────────────────────────────────────────────────────────────
.cache/
*.swp
*.swo

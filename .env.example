# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Secrets must be at least 32 characters. Generate with: openssl rand -base64 32
# There are NO fallbacks — the app refuses to start if any secret is missing.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Super Admin ──────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=""             # openssl rand -base64 32
CRON_SECRET=""                  # openssl rand -base64 32
SUPER_ADMIN_EMAIL=""            # seed only
SUPER_ADMIN_PASSWORD=""         # seed only — use a strong password

# ─── Email ────────────────────────────────────────────────────────────────────
# The only notification channel. Set FROM_EMAIL plus ONE backend below.
FROM_EMAIL="noreply@yourdomain.com"

# Option A — Resend. Needs a verified domain; best deliverability. Preferred
# once you own a domain (a .com costs ~$10/yr and needs no company registration).
RESEND_API_KEY=""

# Option B — plain SMTP. No domain and no registration required, works today.
# Gmail: enable 2-step verification, then create an App Password and use it as
# SMTP_PASSWORD (not the account password). Free Gmail allows ~500 mails/day.
# Resend wins automatically if RESEND_API_KEY is also set.
SMTP_HOST=""            # smtp.gmail.com
SMTP_PORT="587"
SMTP_USER=""            # you@gmail.com
SMTP_PASSWORD=""        # 16-character app password

# ─── WhatsApp (Twilio) — disabled ─────────────────────────────────────────────
# Off by default to keep messaging costs at zero. Set ENABLE_WHATSAPP=true and
# fill in all three values to turn it back on; while off, every WhatsApp send is
# a silent no-op and email continues to work.
ENABLE_WHATSAPP="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

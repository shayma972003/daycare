# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Secrets must be at least 32 characters. Generate with: openssl rand -base64 32
# There are NO fallbacks — the app refuses to start if any secret is missing.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Super Admin ──────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=""             # openssl rand -base64 32
CRON_SECRET=""                  # openssl rand -base64 32
SUPER_ADMIN_EMAIL=""            # seed only
SUPER_ADMIN_PASSWORD=""         # seed only — use a strong password

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Primary notification channel: OTP, password reset, reminders, invoices.
RESEND_API_KEY=""
FROM_EMAIL="noreply@yourdomain.com"

# ─── WhatsApp (Twilio) — disabled ─────────────────────────────────────────────
# Off by default to keep messaging costs at zero. Set ENABLE_WHATSAPP=true and
# fill in all three values to turn it back on; while off, every WhatsApp send is
# a silent no-op and email continues to work.
ENABLE_WHATSAPP="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database
# DATABASE_URL is the pooled Neon URL used by the application and Prisma Client.
# DIRECT_DATABASE_URL is the non-pooler URL used only by Prisma migrations and
# direct administrative database tools. Keep SSL and channel binding enabled.
DATABASE_URL="postgresql://USER:PASSWORD@EP-EXAMPLE-POOLER.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@EP-EXAMPLE.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Application URLs
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth and Super Admin
# The application secrets below must be at least 32 characters. They are
# required in production and must be generated independently.
NEXTAUTH_SECRET=""
ADMIN_JWT_SECRET=""

# PII and OTP
# These values are required in production. Losing PII_ENCRYPTION_KEY makes
# encrypted identity numbers unrecoverable; changing PII_INDEX_PEPPER invalidates
# equality-search indexes. Generate independent values for every secret.
PII_ENCRYPTION_KEY=""
PII_INDEX_PEPPER=""
OTP_HASH_PEPPER=""

# Email provider (optional)
# Keep false in Development and Staging. Set true only after the provider and
# central sender have been approved and verified. Production requires an
# explicit true/false value and accepts no other boolean spelling.
EMAIL_DELIVERY_ENABLED="false"
# FROM_EMAIL is the single central sender address. Resend is preferred when both
# Resend and SMTP are configured. Leave all provider values empty to disable
# outbound email safely in a local or staging environment.
FROM_EMAIL="noreply@example.com"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Storage / Cloudflare R2 (optional)
# Configure all four values together. If they are absent, uploads use the
# database fallback supported by the application.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="daycare-files"

# Moyasar embedded checkout (optional). Use matching test or live keys. The
# publishable key is intentionally used by the browser; never expose the secret.
MOYASAR_SECRET_KEY=""
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=""

# Push notifications (optional)
FCM_SERVER_KEY=""
FCM_PROJECT_ID=""
HMS_APP_ID=""
HMS_ACCESS_TOKEN=""

# Monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN is public by design. The remaining Sentry values are
# used for source-map upload or server-side reporting.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
ERROR_WEBHOOK_URL=""

# Cron (required only when protected cron routes are enabled)
CRON_SECRET=""

# Seed / maintenance tools (never required for normal application runtime)
# seed-admin.ts requires SUPER_ADMIN_* and seed.ts requires SEED_SCHOOL_PASSWORD.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD=""
SEED_SCHOOL_EMAIL="school-admin@example.com"
SEED_SCHOOL_PASSWORD=""

# PII backfill tools require an explicit schema confirmation before writing.
ENROLLMENT_PII_BACKFILL_SCHEMA=""
CONFIRM_ENROLLMENT_PII_BACKFILL_SCHEMA=""
ENROLLMENT_PII_BACKFILL_BATCH_SIZE="100"
IMPORT_ROW_BACKFILL_SCHEMA=""
CONFIRM_IMPORT_ROW_BACKFILL_SCHEMA=""
IMPORT_ROW_BACKFILL_BATCH_SIZE="100"
